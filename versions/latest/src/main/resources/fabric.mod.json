{
	"schemaVersion": 1,
	"id": "imperiumclient",
	"version": "${version}",
	"name": "Romanica Client",
	"description": "Client mod made for Romanica: module menu, HUD and quality-of-life features. Based on AxolotlClient.",
	"authors": [
		"MylesThePro1",
		"Romanica Contributors"
	],
	"contributors": [
		"moehreag (AxolotlClient)",
		"YakisikliBaran",
		"DragonEggBedrockBreaking",
		"TheKodeToad",
		"CornetPanique86"
	],
	"contact": {
		"homepage": "https://romanica.net",
		"sources": "https://github.com/Romanica-MC/RomanicaClient",
		"issues": "https://github.com/Romanica-MC/RomanicaClient/issues"
	},
	"license": "LGPL-3.0-or-later",
	"icon": "assets/imperiumclient/icon.png",
	"accessWidener": "axolotlclient.classtweaker",
	"environment": "client",
	"entrypoints": {
		"client": [
			"io.github.axolotlclient.AxolotlClient",
			{
				"adapter": "kotlin",
				"value": "io.github.axolotlclient.imperium.media.ImperiumMediaInit"
			},
			{
				"adapter": "kotlin",
				"value": "io.github.axolotlclient.imperium.online.ImperiumOnline"
			}
		],
		"modmenu": [
			"io.github.axolotlclient.config.modmenu.ModMenuCompat"
		]
	},
	"mixins": [
		"axolotlclient.mixins.json",
		"axolotlclient-bridge.mixins.json",
		"axolotlclient.e4mc.mixins.json",
		"imperiumclient-enforcement.mixins.json"
	],
	"custom": {
		"axolotlclient:bridge_impl_version": "V26_3"
	},
	"depends": {
		"fabricloader": ">=0.18.0",
		"minecraft": "~26.3-",
		"fabric-api": "*",
		"fabric-language-kotlin": ">=1.14.2",
		"axolotlclientconfig": "*",
		"axolotlclient-common": "*"
	},
	"provides": [
		"axolotlclient"
	]
}